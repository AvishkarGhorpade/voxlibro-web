// ==========================================================================
// VoxLibro — Prisma Schema
// Database: PostgreSQL (Supabase)
// ==========================================================================
// This schema models:
//  - NextAuth's required tables (Account/Session/VerificationToken)
//  - Admin users with role-based access control
//  - Blog content: Post, Category, Tag (many-to-many), Media
//  - Draft/publish workflow with autosave revisions
//  - Analytics events for the dashboard
// ==========================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev on whatever OS the developer uses; the
  // explicit Linux targets cover common deployment environments (Vercel,
  // Docker, most CI) so the client isn't accidentally generated for only
  // one platform and broken everywhere else.
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: use the pooled connection for the app and a direct
  // connection for migrations, to avoid exhausting Postgres connections.
  directUrl = env("DIRECT_URL")
}

// --------------------------------------------------------------------------
// Auth (NextAuth "Database" model — Credentials + future OAuth providers)
// --------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN // full access, can manage other admins
  ADMIN       // can publish/manage all content
  EDITOR      // can create/edit but not publish or delete
  AUTHOR      // can create/edit only their own posts
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // bcrypt hash, only for credentials login
  role          Role      @default(AUTHOR)
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  mediaUploads  Media[]
  postRevisions PostRevision[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --------------------------------------------------------------------------
// Blog content
// --------------------------------------------------------------------------

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id       String     @id @default(cuid())
  slug     String     @unique
  title    String
  excerpt  String?
  // Raw markdown is the source of truth. Rendering to HTML happens at
  // request time (or is cached) — never stored pre-rendered to avoid
  // stored-XSS from unsanitized HTML living in the DB.
  content  String     @db.Text
  status   PostStatus @default(DRAFT)

  coverImageId String?
  coverImage   Media?  @relation(fields: [coverImageId], references: [id], onDelete: SetNull)

  readingTimeMinutes Int? // derived from word count, cached on save

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags PostTag[]

  viewCount Int @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  revisions PostRevision[]
  analytics AnalyticsEvent[]

  @@index([status, publishedAt])
  @@index([slug])
  @@index([categoryId])
  @@map("posts")
}

// Autosave / revision history. Every autosave or manual save writes a
// snapshot here so drafts can be recovered without polluting the Post row.
model PostRevision {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  excerpt   String?
  content   String   @db.Text
  isAutosave Boolean @default(true)
  createdAt DateTime @default(now())
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([postId, createdAt])
  @@map("post_revisions")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  posts     PostTag[]
  createdAt DateTime  @default(now())

  @@map("tags")
}

// Explicit join table (rather than an implicit m2m) so we can index it
// and extend it later (e.g. tag ordering) without a migration surprise.
model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// --------------------------------------------------------------------------
// Media Library (Cloudinary-backed)
// --------------------------------------------------------------------------

enum MediaType {
  IMAGE
  VIDEO
  RAW
}

model Media {
  id           String    @id @default(cuid())
  publicId     String    @unique // Cloudinary public_id, needed to delete/transform
  url          String
  secureUrl    String
  type         MediaType @default(IMAGE)
  format       String?
  width        Int?
  height       Int?
  bytes        Int?
  altText      String?
  folder       String    @default("voxlibro/uploads")

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  posts     Post[]
  createdAt DateTime @default(now())

  @@index([uploadedById])
  @@map("media")
}

// --------------------------------------------------------------------------
// Contact form
// --------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}

// --------------------------------------------------------------------------
// Analytics
// --------------------------------------------------------------------------

enum AnalyticsEventType {
  PAGE_VIEW
  POST_VIEW
  SEARCH
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  postId    String?
  post      Post?              @relation(fields: [postId], references: [id], onDelete: SetNull)
  path      String?
  query     String? // for SEARCH events
  referrer  String?
  userAgent String?
  // Coarse, privacy-preserving identifiers only — never store raw IPs.
  ipHash    String?
  createdAt DateTime           @default(now())

  @@index([type, createdAt])
  @@index([postId])
  @@map("analytics_events")
}
