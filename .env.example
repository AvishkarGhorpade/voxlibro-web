# ==========================================================================
# VoxLibro Backend — Environment Variables
# Copy to .env.local (dev) or configure in your host's dashboard (prod).
# Never commit the real .env / .env.local file.
# ==========================================================================

# --- Database (Supabase Postgres) ----------------------------------------
# Pooled connection (via Supabase's pgbouncer / port 6543) — used by the app
# at runtime for normal queries.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only for `prisma migrate`, which
# cannot run through the pgbouncer connection pooler.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- NextAuth --------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudinary (media library / image uploads) ----------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Rate limiting (Upstash Redis) ------------------------------------------
# Optional in development — falls back to an in-memory limiter (see
# lib/rate-limit.ts) if unset. REQUIRED in any multi-instance production
# deployment (e.g. Vercel), since the in-memory fallback is per-instance
# and does not share state across serverless invocations.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Analytics ---------------------------------------------------------------
# Salt mixed into hashed IPs (lib/security.ts:hashIp) so visitor IPs are
# never stored in reversible form. Generate with: openssl rand -hex 16
ANALYTICS_SALT="replace-with-a-random-hex-string"

# --- Seeding (prisma/seed.ts) ------------------------------------------------
# Used once, by `npm run db:seed`, to create the first SUPER_ADMIN account.
# Not read at runtime — safe to remove from production env after seeding.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# --- Public site config (config/site.ts) ------------------------------------
# REQUIRED in production — used for metadataBase, sitemap.xml, robots.txt,
# RSS feed links, and JSON-LD schema. Must be the real deployed domain.
NEXT_PUBLIC_SITE_URL="https://your-real-domain.example"

# Optional — each of these is hidden from the UI (no button/link rendered)
# until you set it. Never fake these; leave unset if unknown.
NEXT_PUBLIC_PLAY_STORE_URL=""
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_TWITTER_URL=""
NEXT_PUBLIC_CONTACT_EMAIL=""
